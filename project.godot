; Engine configuration file.
config_version=5

[application]

config/name="Uncertainty Boom"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/icon/icon.png"
config/windows_native_icon="res://assets/icon/icon.ico"

[autoload]

Events="*res://autoload/events.gd"
Game="*res://autoload/game.gd"
Sfx="*res://autoload/sfx.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[gui]

theme/default_font_antialiasing=0
theme/default_font_hinting=0
theme/default_font_subpixel_positioning=0

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemies"
2d_physics/layer_4="player_shots"
2d_physics/layer_5="enemy_shots"
2d_physics/layer_6="pickups"

[physics]

common/physics_ticks_per_second=60

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.05, 0.16, 0.27, 1)
